# Copy this file to ".env.local" for local dev.

SUPABASE_URL=https://nfvxmkknkxysjksyhbek.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Shared access key. The site is gated until a visitor arrives with
# ?k=<this value> (which then sets a year-long cookie). Leave it unset
# locally to disable the gate; set it in Vercel to arm it in production.
SITE_KEY=your-shared-key
